<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- Custom Checkstyle configuration for Soc Ops project -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java,properties,xml"/>

    <!-- Regexp for line length (120 characters max) -->
    <module name="LineLength">
        <property name="fileExtensions" value="java"/>
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://"/>
    </module>

    <!-- TreeWalker checks -->
    <module name="TreeWalker">
        <!-- Imports - Key checks for unused imports -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports">
            <property name="processJavadoc" value="false"/>
        </module>
        <module name="ImportOrder">
            <property name="groups" value="java,javax,org,com"/>
            <property name="ordered" value="true"/>
            <property name="separated" value="true"/>
            <property name="option" value="top"/>
            <property name="sortStaticImportsAlphabetically" value="true"/>
        </module>

        <!-- Class/Interface Design -->
        <module name="VisibilityModifier">
            <property name="packageAllowed" value="false"/>
            <property name="protectedAllowed" value="false"/>
            <property name="allowPublicFinalFields" value="false"/>
            <property name="allowPublicImmutableFields" value="true"/>
        </module>

        <!-- Naming conventions -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- Code style checks -->
        <module name="NeedBraces"/>
        <module name="EmptyBlock"/>
        <module name="EmptyStatement"/>

        <!-- Whitespace -->
        <module name="NoWhitespaceAfter">
            <property name="tokens" value="BNOT,DEC,DOT,INC,LNOT,UNARY_MINUS,UNARY_PLUS"/>
        </module>
        <module name="NoWhitespaceBefore">
            <property name="tokens" value="COMMA,SEMI,POST_DEC,POST_INC"/>
        </module>

        <!-- Modifiers -->
        <module name="ModifierOrder"/>

        <!-- Misc -->
        <module name="ArrayTypeStyle"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="OneStatementPerLine"/>
        <module name="DefaultComesLast"/>

        <!-- Javadoc -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
        </module>

        <!-- Code complexity -->
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
        </module>
    </module>

    <!-- Suppress checks if suppressed with @SuppressWarnings -->
    <module name="SuppressWarningsFilter"/>
</module>
